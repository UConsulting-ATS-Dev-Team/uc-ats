generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                          @id @default(uuid())
  email                      String                          @unique
  // Null means the account has no password at all, which is different from
  // "wrong password" and has to stay tellable apart: it is what lets /login
  // answer a Google-only account with "use Google" instead of the generic
  // "invalid email or password". Accounts promoted by decisionProcessing get a
  // random unusable hash rather than null - deliberately, since those people are
  // expected to set a password through the reset flow.
  password                   String?
  fullName                   String
  graduationClass            String?
  role                       UserRole                        @default(USER)
  isActive                   Boolean                         @default(true)
  deactivatedAt              DateTime?
  deactivatedBy              String?
  createdAt                  DateTime                        @default(now())
  resetToken                 String?
  resetTokenExpiry           DateTime?
  // Email ownership, proved by clicking a link. Null means unproven, which for
  // a self-registered external account is the difference between "someone typed
  // this address" and "this person reads it". Staff accounts are created by an
  // admin and are never gated on it.
  emailVerifiedAt            DateTime?
  emailVerificationToken     String?                         @unique
  emailVerificationExpiry    DateTime?
  // True only for accounts created through the public talent portal
  // (POST /api/auth/register-external). Distinguishes a self-registered UCLA
  // student from an applicant who signed up to track their application: both
  // are role USER, but only the former has no Candidate row and lands on the
  // talent profile instead of the application list.
  isExternalTalent           Boolean                         @default(false)
  // Google's `sub` claim - stable for the life of the Google account, and
  // unlike the email it does not change when somebody renames their address.
  // Matched before email for exactly that reason.
  googleId                   String?                         @unique
  googleLinkedAt             DateTime?
  profileImage               String?
  studentId                  String?                         @unique
  // E.164 (+13105551234), for Master Communications iMessage to members. Filled
  // from the roster CSV by scripts/import-member-phones-from-csv.js - applicants'
  // numbers live on Application.phoneNumber and are never copied here.
  phoneNumber                String?
  createdBehavioralQuestions BehavioralQuestion[]
  comments                   Comment[]
  coverLetterScores          CoverLetterScore[]
  evaluations                Evaluation[]
  firstRoundEvaluations      FirstRoundInterviewEvaluation[] @relation("FirstRoundEvaluator")
  flaggedDocuments           FlaggedDocument[]               @relation("DocumentFlagger")
  resolvedDocuments          FlaggedDocument[]               @relation("DocumentResolver")
  memberOneGroups            Groups[]                        @relation("GroupMemberOne")
  memberThreeGroups          Groups[]                        @relation("GroupMemberThree")
  memberTwoGroups            Groups[]                        @relation("GroupMemberTwo")
  groupMemberships           GroupMember[]
  completedActionItems       InterviewActionItem[]           @relation("InterviewActionItemCompletion")
  interviewAssignments       InterviewAssignment[]           @relation("InterviewAssignment")
  interviewSlotAssignments   InterviewSlotAssignment[]       @relation("InterviewSlotAssignment")
  interviewerAvailability    InterviewerAvailability[]       @relation("InterviewerAvailability")
  interviewEvaluations       InterviewEvaluation[]           @relation("InterviewEvaluator")
  interviewResources         InterviewResource[]
  createdInterviews          Interview[]                     @relation("InterviewCreator")
  meetingSlots               MeetingSlot[]
  memberEventRsvp            MemberEventRsvp[]
  resumeScores               ResumeScore[]
  videoScores                VideoScore[]
  conversationParticipants   ConversationParticipant[]       @relation("ConversationParticipantUser")
  sentMessages               Message[]                       @relation("MessageSender")
  createdCases               Case[]                          @relation("CaseCreator")
  caseAssignments            CaseAssignment[]                @relation("CaseAssigner")
  gtkucProfile               MemberGtkucProfile?
  createdCycles              RecruitingCycle[]               @relation("RecruitingCycleCreator")
  memberEventAttendances     MemberEventAttendance[]
  resumeUploads              ResumeUpload[]                  @relation("ResumeUploader")
  createdMessageTemplates    MessageTemplate[]               @relation("MessageTemplateCreator")
  createdMessageDrafts       MessageDraft[]                  @relation("MessageDraftCreator")
  editedMessageDrafts        MessageDraft[]                  @relation("MessageDraftEditor")
  sentMessageLogs            MessageLog[]                    @relation("MessageLogSender")
  scheduledMessages          MessageSchedule[]               @relation("ScheduleSender")
  triggeredCommunications    CommunicationLog[]              @relation("CommunicationLogTrigger")
  talentPartnerClient        TalentPartnerClient?            @relation("TalentPartnerClientUser")
  createdTalentPartners      TalentPartnerClient[]           @relation("TalentPartnerClientCreator")
  submittedReferrals         Referral[]                      @relation("ReferralSubmitter")
  memberResumes              MemberResume[]
  externalResumes            ExternalResume[]
  createdClientBatches       ClientAssignmentBatch[]         @relation("ClientBatchCreator")
  assignedClientResumes      ClientResumeAssignment[]        @relation("ClientAssignmentAssigner")
  revokedClientResumes       ClientResumeAssignment[]        @relation("ClientAssignmentRevoker")
  clientAccessLogs           ClientResumeAccessLog[]         @relation("ClientAccessLogUser")
  announcementReads          MemberAnnouncementRead[]
  createdLiveVoteSessions    LiveVoteSession[]               @relation("LiveVoteSessionCreator")
  liveVoteParticipations     LiveVoteParticipant[]           @relation("LiveVoteParticipantUser")
  lumaGuests                 LumaGuest[]

  @@map("users")
}

model Candidate {
  id                String               @id @default(uuid())
  studentId         String               @unique
  firstName         String
  lastName          String
  email             String               @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  assignedGroupId   String?
  applications      Application[]
  assignedGroup     Groups?              @relation(fields: [assignedGroupId], references: [id])
  coffeeChat        CoffeeChat[]
  coverLetterScores CoverLetterScore[]
  eventAttendance   EventAttendance[]
  eventRsvp         EventRsvp[]
  referrals         Referral[]
  resumeScores      ResumeScore[]
  roundOne          RoundOne[]
  roundTwo          RoundTwo[]
  videoScores       VideoScore[]
  onboarding        CandidateOnboarding?
  lumaGuests        LumaGuest[]
  /// When set, this person's scores, evaluations, comments and application are
  /// sealed: staff routes answer 423 or redact them unless the request carries
  /// an executive unlock (server/src/utils/lockedRecords.js). Set automatically
  /// when the person becomes a member, because members can later be promoted
  /// onto recruitment and would otherwise read their own file.
  recordsLockedAt   DateTime?
  /// User who sealed the record; null when a script or the decision pipeline did.
  recordsLockedById String?

  @@map("candidates")
}

/// The executive-committee password that unseals Candidate records. One row,
/// id "singleton", holding a bcrypt hash and nothing else. Set it with
/// server/scripts/set-exec-password.js.
model ExecAccessSetting {
  id           String   @id @default("singleton")
  passwordHash String
  updatedById  String?
  updatedAt    DateTime @updatedAt

  @@map("exec_access_settings")
}

/// Audit trail for sealed records: every unlock attempt, seal, unseal and
/// password change. action is one of EXEC_ACCESS_ACTIONS in
/// server/src/services/execAccess.js; userId is null when a script acted.
model ExecAccessLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  candidateId String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([candidateId])
  @@map("exec_access_logs")
}

/// What decision processing did to one application, and so which email it gets.
enum DecisionOutcome {
  ADVANCED
  REJECTED
  ACCEPTED
}

enum DecisionMessageStatus {
  PENDING
  EXCLUDED
  SENDING
  SENT
  FAILED
}

/// One run of "Process All Decisions" on Staging. Processing changes application
/// state and sends nothing; the decision emails it implies wait here, one row per
/// recipient, until an admin reviews and sends them from Master Communications.
model DecisionBatch {
  id            String            @id @default(uuid())
  cycleId       String
  /// The Staging round that was processed, '1' (resume review) to '4' (final).
  round         String
  /// Subject and body per outcome - { ADVANCED?, REJECTED?, ACCEPTED? } each
  /// { subject, body } - copied from the defaults when the batch is made, so
  /// editing one batch's wording never changes another's.
  templates     Json
  processedById String
  processedAt   DateTime          @default(now())
  messages      DecisionMessage[]

  @@index([cycleId, processedAt])
  @@map("decision_batches")
}

model DecisionMessage {
  id                String                @id @default(uuid())
  batchId           String
  applicationId     String
  candidateId       String?
  userId            String?
  email             String
  firstName         String
  lastName          String
  outcome           DecisionOutcome
  fromRound         String
  toRound           String?
  /// Processing created a member account for this person, so their email carries
  /// a set-your-password link. The link's token is minted when the email is sent,
  /// not when the batch is made, so a batch that waits for review cannot expire it.
  needsInvite       Boolean               @default(false)
  status            DecisionMessageStatus @default(PENDING)
  attempts          Int                   @default(0)
  sentAt            DateTime?
  sentById          String?
  error             String?
  providerMessageId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  batch             DecisionBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// One email per decision, ever: processing the same round again cannot queue
  /// a second copy.
  @@unique([applicationId, fromRound, outcome])
  @@index([batchId, outcome, status])
  @@map("decision_messages")
}

// Applicant information a candidate supplies themselves, at signup, when we
// have no application to read it from.
//
// Deliberately NOT columns on Candidate. Everything on Candidate arrives from
// the Google Forms sync and is corroborated by a submitted application; this is
// self-reported by someone who has done nothing but verify an email address.
// Keeping the two apart means no screen can mistake one for the other, and the
// row can be dropped wholesale once a real application lands.
//
// There is no cover letter or video here on purpose - the module asks for a
// resume and nothing else file-wise. The headshot is optional, which is why it
// is nullable while the resume columns are not.
model CandidateOnboarding {
  id                   String    @id @default(uuid())
  candidateId          String    @unique
  phoneNumber          String
  // Four bare digits, matching Application.graduationYear rather than the free
  // text User.graduationClass holds, so the two filter alike.
  graduationYear       String
  cumulativeGpa        Decimal   @db.Decimal(3, 2)
  major1               String
  major2               String?
  gender               String?
  isTransferStudent    Boolean
  isFirstGeneration    Boolean
  // Relative to server/storage, the same private root external resumes use -
  // never uploads/, which index.js serves unauthenticated.
  resumeStoragePath    String
  resumeOriginalName   String
  resumeFileSize       Int
  headshotStoragePath  String?
  headshotOriginalName String?
  headshotFileSize     Int?
  completedAt          DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  candidate            Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_onboarding")
}

model Application {
  id                    String                          @id @default(uuid())
  status                ApplicationStatus               @default(SUBMITTED)
  responseID            String                          @unique
  submittedAt           DateTime                        @default(now())
  email                 String
  firstName             String
  lastName              String
  studentId             String
  phoneNumber           String
  graduationYear        String
  isTransferStudent     Boolean
  priorCollegeYears     String?
  cumulativeGpa         Decimal                         @db.Decimal(3, 2)
  majorGpa              Decimal?                        @db.Decimal(3, 2)
  major1                String
  major2                String?
  gender                String?
  isFirstGeneration     Boolean
  // Talent Partner Network opt-in, added to the application form for the
  // Winter 2026 cycle. Nullable because every Fall 2025 application predates
  // the question, and Winter 2026 applications that skipped it have no answer.
  talentPoolOptIn       Boolean?
  resumeUrl             String
  blindResumeUrl        String?
  headshotUrl           String
  coverLetterUrl        String?
  videoUrl              String?
  rawResponses          Json
  approved              Boolean?
  currentRound          String?
  resumeDecision        String?
  coffeeChatDecision    String?
  firstRoundDecision    String?
  finalRoundDecision    String?
  cycleId               String?
  candidateId           String?
  testFor               String?
  candidate             Candidate?                      @relation(fields: [candidateId], references: [id])
  cycle                 RecruitingCycle?                @relation(fields: [cycleId], references: [id])
  comments              Comment[]
  firstRoundEvaluations FirstRoundInterviewEvaluation[]
  flaggedDocuments      FlaggedDocument[]
  interviewEvaluations  InterviewEvaluation[]
  caseAssignments       CaseAssignment[]
  resumeUploads         ResumeUpload[]
  clientAssignments     ClientResumeAssignment[]
  behavioralQuestions   BehavioralQuestion[]
  slotSignups           InterviewSlotSignup[]
  liveVoteEntries       LiveVoteSessionCandidate[]

  @@map("applications")
}

// One row per version of an application's resume, newest last. Candidates may
// replace their own resume until the cycle's `resumeDeadline` passes, and
// reviewers grade whatever `Application.resumeUrl` pointed at, so the version
// that was actually scored has to stay recoverable.
//
// `storagePath` is null for the resume the application arrived with: that file
// lives in Google Drive (uploaded through the application form), not in our
// storage directory. `sourceUrl` records what `Application.resumeUrl` held for
// this version, which is what the client fetches to view it either way.
model ResumeUpload {
  id            String      @id @default(uuid())
  applicationId String
  storagePath   String?
  sourceUrl     String
  originalName  String?
  sizeBytes     Int?
  uploadedById  String?
  uploadedAt    DateTime    @default(now())
  // Set when a newer upload takes over. Exactly one row per application should
  // have this null — the version `Application.resumeUrl` currently points at.
  supersededAt  DateTime?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy    User?       @relation("ResumeUploader", fields: [uploadedById], references: [id])

  @@index([applicationId, uploadedAt])
  @@map("resume_uploads")
}

model RecruitingCycle {
  id                        String                           @id @default(uuid())
  // Unique so an exact retry of a bootstrap commit recovers the cycle it
  // already created instead of making a second one.
  name                      String                           @unique
  // Activation is audience-scoped. `isActive` is the cycle members, candidates and
  // the public pages see; `isAdminActive` is the cycle admins see. They are normally
  // the same row and differ only during a handover, where admins finish out the
  // closing cycle while the next one opens to candidates.
  //
  // At most one cycle may carry each flag. Enforced by the partial unique indexes
  // `recruiting_cycles_single_active` and `recruiting_cycles_single_admin_active`,
  // which Prisma's schema cannot express, so they are created in SQL by the
  // migrations and must be re-added by hand if this table is ever recreated.
  //
  // Never read either column directly: go through resolveCycle()/resolveCycleForRequest()
  // in services/activeCycle.js, which maps the caller's role to the right pointer and
  // falls back to `isActive` when no admin cycle is pinned.
  isActive                  Boolean                          @default(false)
  isAdminActive             Boolean                          @default(false)
  startDate                 DateTime?
  endDate                   DateTime?
  createdAt                 DateTime                         @default(now())
  formUrl                   String?
  resumeDeadline            String?
  coverLetterDeadline       String?
  videoDeadline             String?
  // Structured timeline captured at cycle-create time, plus the audit of who
  // committed it. Stage dates live here (and on the generated events) rather
  // than in one column per stage, so adding a stage is config-only.
  createdById               String?
  timelineSnapshot          Json?
  timelineCommittedAt       DateTime?
  // Hash of the whole bootstrap request (name, timeline, activate flag, per-event
  // overrides), so only a byte-identical retry is answered with this cycle.
  bootstrapFingerprint      String?
  publishChangeSet          Json?
  createdBy                 User?                            @relation("RecruitingCycleCreator", fields: [createdById], references: [id])
  applications              Application[]
  coverLetterScores         CoverLetterScore[]
  events                    Events[]
  groups                    Groups[]
  interviews                Interview[]
  referrals                 Referral[]
  resumeScores              ResumeScore[]
  videoScores               VideoScore[]
  cases                     Case[]
  gtkucProfileConfirmations MemberGtkucProfileConfirmation[]
  messageTemplates          MessageTemplate[]                @relation("CycleTemplates")
  messageDrafts             MessageDraft[]                   @relation("CycleDrafts")
  messageLogs               MessageLog[]                     @relation("CycleLogs")
  scheduledMessages         MessageSchedule[]                @relation("ScheduleCycle")
  communicationLogs         CommunicationLog[]               @relation("CycleCommunicationLogs")
  helpAnnouncements         HelpAnnouncement[]
  liveVoteSessions          LiveVoteSession[]

  @@map("recruiting_cycles")
}

// Single-row table bumped by database triggers on every write to the tables the
// Staging snapshot reads. Clients poll this instead of the snapshot itself and only
// pay for the expensive read when `version` has actually moved. See the
// `add_staging_change_token` migration for the trigger definitions.
model StagingChangeToken {
  id        String   @id
  version   BigInt   @default(0)
  changedAt DateTime @default(now())

  @@map("staging_change_tokens")
}

// Candidate-facing background for a member hosting Get to Know UC slots.
// Industries come from a fixed taxonomy so candidates never see employer names.
// There is no free-text field on purpose: everything shown to a candidate is
// either a taxonomy tag or the member's own LinkedIn link.
model MemberGtkucProfile {
  id               String                           @id @default(uuid())
  memberId         String                           @unique
  industries       String[]
  interests        String[]
  // Auto-filled from the UConsulting team page and editable by the member.
  linkedinUrl      String?
  candidateVisible Boolean                          @default(true)
  hiddenFromGtkuc  Boolean                          @default(false)
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  member           User                             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  confirmations    MemberGtkucProfileConfirmation[]

  @@map("member_gtkuc_profiles")
}

// One row per member per cycle: the member confirmed their profile is current.
// Confirmation resets every cycle because there is no row for the new cycle.
model MemberGtkucProfileConfirmation {
  id          String             @id @default(uuid())
  profileId   String
  cycleId     String
  confirmedAt DateTime           @default(now())
  profile     MemberGtkucProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cycle       RecruitingCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([profileId, cycleId])
  @@map("member_gtkuc_profile_confirmations")
}

model Comment {
  id            String      @id @default(uuid())
  applicationId String
  userId        String
  content       String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@map("comments")
}

model Grade {
  id           String   @id @default(uuid())
  resume       String?
  video        String?
  createdAt    DateTime @default(now())
  cover_letter String?
  applicant    String?
  user         String?

  @@map("grades")
}

model Evaluation {
  id           String      @id @default(uuid())
  notes        String?
  score        Int
  evaluatorId  String
  createdAt    DateTime    @default(now())
  coffeeChatId String?
  roundOneId   String?
  roundTwoId   String?
  coffeeChat   CoffeeChat? @relation(fields: [coffeeChatId], references: [id])
  evaluator    User        @relation(fields: [evaluatorId], references: [id])
  roundOne     RoundOne?   @relation(fields: [roundOneId], references: [id])
  roundTwo     RoundTwo?   @relation(fields: [roundTwoId], references: [id])

  @@map("evaluations")
}

model Groups {
  id                 String             @id @default(uuid())
  memberOne          String?
  memberTwo          String?
  memberThree        String?
  avgScore           Decimal?           @db.Decimal(5, 2)
  cycleId            String
  createdAt          DateTime           @default(now())
  name               String?
  assignedCandidates Candidate[]
  coverLetterScores  CoverLetterScore[]
  cycle              RecruitingCycle    @relation(fields: [cycleId], references: [id])
  memberOneUser      User?              @relation("GroupMemberOne", fields: [memberOne], references: [id])
  memberThreeUser    User?              @relation("GroupMemberThree", fields: [memberThree], references: [id])
  memberTwoUser      User?              @relation("GroupMemberTwo", fields: [memberTwo], references: [id])
  groupMembers       GroupMember[]
  resumeScores       ResumeScore[]
  videoScores        VideoScore[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Groups @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model ResumeScore {
  id              String           @id @default(uuid())
  overallScore    Decimal          @db.Decimal(5, 2)
  scoreOne        Int?
  scoreTwo        Int?
  scoreThree      Int?
  adminScore      Decimal?         @db.Decimal(5, 2)
  adminNotes      String?
  status          String?
  candidateId     String
  evaluatorId     String
  assignedGroupId String?
  createdAt       DateTime         @default(now())
  cycleId         String?
  notes           String?
  assignedGroup   Groups?          @relation(fields: [assignedGroupId], references: [id])
  candidate       Candidate        @relation(fields: [candidateId], references: [id])
  cycle           RecruitingCycle? @relation(fields: [cycleId], references: [id])
  evaluator       User             @relation(fields: [evaluatorId], references: [id])

  @@unique([candidateId, evaluatorId, cycleId])
  @@map("resume_scores")
}

model CoverLetterScore {
  id              String           @id @default(uuid())
  overallScore    Decimal          @db.Decimal(5, 2)
  scoreOne        Int?
  scoreTwo        Int?
  scoreThree      Int?
  notesOne        String?
  notesTwo        String?
  notesThree      String?
  adminScore      Decimal?         @db.Decimal(5, 2)
  adminNotes      String?
  status          String?
  candidateId     String
  evaluatorId     String?
  assignedGroupId String?
  createdAt       DateTime         @default(now())
  cycleId         String?
  assignedGroup   Groups?          @relation(fields: [assignedGroupId], references: [id])
  candidate       Candidate        @relation(fields: [candidateId], references: [id])
  cycle           RecruitingCycle? @relation(fields: [cycleId], references: [id])
  evaluator       User?            @relation(fields: [evaluatorId], references: [id])

  @@unique([candidateId, evaluatorId, cycleId])
  @@map("cover_letter_scores")
}

model VideoScore {
  id              String           @id @default(uuid())
  overallScore    Decimal          @db.Decimal(5, 2)
  scoreOne        Int?
  scoreTwo        Int?
  scoreThree      Int?
  notesOne        String?
  notesTwo        String?
  notesThree      String?
  adminScore      Decimal?         @db.Decimal(5, 2)
  adminNotes      String?
  status          String?
  candidateId     String
  evaluatorId     String?
  assignedGroupId String?
  createdAt       DateTime         @default(now())
  cycleId         String?
  assignedGroup   Groups?          @relation(fields: [assignedGroupId], references: [id])
  candidate       Candidate        @relation(fields: [candidateId], references: [id])
  cycle           RecruitingCycle? @relation(fields: [cycleId], references: [id])
  evaluator       User?            @relation(fields: [evaluatorId], references: [id])

  @@unique([candidateId, evaluatorId, cycleId])
  @@map("video_scores")
}

model Events {
  id                 String            @id @default(uuid())
  eventName          String
  eventStartDate     DateTime
  eventEndDate       DateTime
  eventLocation      String?
  rsvpForm           String?
  attendanceForm     String?
  cycleId            String
  createdAt          DateTime          @default(now())
  memberRsvpUrl      String?
  showToCandidates   Boolean           @default(false)
  copiedFromCycleId  String?
  copiedFromEventId  String?
  copiedByUserId     String?
  copiedAt           DateTime?
  // Provenance for events generated by cycle bootstrap, and the explicit
  // "form still missing" marker for shells that expect RSVP/attendance forms.
  generatedFromStage      String?
  formStatus              EventFormStatus?
  eventAttendance         EventAttendance[]
  eventRsvp               EventRsvp[]
  memberAttendanceForm    String?
  memberEventAttendance   MemberEventAttendance[]
  cycle                   RecruitingCycle   @relation(fields: [cycleId], references: [id])
  memberEventRsvp         MemberEventRsvp[]
  // The Luma event that replaces this event's Google Forms. lumaUrl is what an
  // admin pastes (luma.com/<slug>); lumaEventId is the evt-... id the sync
  // routine resolves it to, and what each page of guests is checked against.
  lumaUrl                 String?
  lumaEventId             String?           @unique
  lumaLastSyncedAt        DateTime?
  lumaGuests              LumaGuest[]

  @@unique([cycleId, copiedFromCycleId, copiedFromEventId])
  @@unique([cycleId, generatedFromStage])
  @@map("events")
}

enum EventFormStatus {
  PENDING_FORM
  CONNECTED
}

/// Where an RSVP or attendance row came from. Google Form rows carry the form
/// responseId; Luma rows carry the Luma guest id instead, and the Luma sync
/// only ever removes rows it wrote itself. IN_APP is a member's own RSVP from
/// the Events page, and cancelling there only ever removes an IN_APP row.
enum EventResponseSource {
  GOOGLE_FORM
  LUMA
  IN_APP
}

model EventRsvp {
  id          String              @id @default(uuid())
  responseId  String?             @unique
  eventId     String
  candidateId String
  createdAt   DateTime            @default(now())
  source      EventResponseSource @default(GOOGLE_FORM)
  lumaGuestId String?             @unique
  candidate   Candidate           @relation(fields: [candidateId], references: [id])
  event       Events              @relation(fields: [eventId], references: [id])

  @@unique([eventId, candidateId])
  @@map("event_rsvp")
}

model EventAttendance {
  id          String              @id @default(uuid())
  responseId  String?             @unique
  eventId     String
  candidateId String
  createdAt   DateTime            @default(now())
