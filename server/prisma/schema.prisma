  id               String       @id @default(uuid())
  caseId           String
  pageNumber       Int
  imageStoragePath String
  pageType         CasePageType @default(NORMAL)
  exhibitLabel     String?
  width            Int?
  height           Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  case             Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, pageNumber])
  @@map("case_pages")
}

model CaseAssignment {
  id            String      @id @default(uuid())
  caseId        String
  interviewId   String
  applicationId String
  assignedBy    String
  overriddenBy  String?
  overriddenAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  case          Case        @relation(fields: [caseId], references: [id])
  interview     Interview   @relation(fields: [interviewId], references: [id])
  application   Application @relation(fields: [applicationId], references: [id])
  assigner      User        @relation("CaseAssigner", fields: [assignedBy], references: [id])

  @@unique([interviewId, applicationId])
  @@map("case_assignments")
}

/// id "singleton". How many hours before an interview's startDate a MEMBER may
/// read that interview's assigned case content. ADMIN is exempt. Larger means
/// EARLIER access: 0 unlocks exactly at the start time, 720 (30 days) is
/// effectively no restriction. Read through
/// server/src/services/caseVisibility.js, never directly.
model CaseVisibilitySetting {
  id            String   @id @default("singleton")
  leadTimeHours Int      @default(2)
  updatedById   String?
  updatedAt     DateTime @updatedAt

  @@map("case_visibility_settings")
}

model HelpAnnouncement {
  id          String                @id @default(uuid())
  title       String
  body        String                @default("")
  publishedAt DateTime              @default(now())
  cycleId     String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  cycle       RecruitingCycle?      @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  reads       MemberAnnouncementRead[]

  @@index([cycleId])
  @@map("help_announcements")
}

model Tutorial {
  id          String           @id @default(uuid())
  title       String
  description String?
  category    TutorialCategory
  videoUrl    String?
  body        String?
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
  @@map("tutorials")
}

model MemberAnnouncementRead {
  id            String          @id @default(uuid())
  memberId      String
  announcementId String
  readAt        DateTime        @default(now())
  member        User            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  announcement  HelpAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([memberId, announcementId])
  @@index([memberId])
  @@index([announcementId])
  @@map("member_announcement_reads")
}

enum TutorialCategory {
  DOCUMENT_GRADING
  INTERVIEW_CONDUCT
  GTKUC
  ATS_NAVIGATION
  NEW_FEATURES
}

enum UserRole {
  USER
  ADMIN
  MEMBER
  // Talent Partner Network buyer. Reaches only /api/client/* - see
  // src/middleware/externalContainment.js. Created exclusively through
  // POST /api/admin/talent-pool/clients so a TalentPartnerClient row always exists.
  CLIENT
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum InterviewType {
  COFFEE_CHAT
  ROUND_ONE
  ROUND_TWO
  FINAL_ROUND
  DELIBERATIONS
}

enum InterviewStatus {
  DRAFT
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InterviewerRole {
  LEAD_INTERVIEWER
  INTERVIEWER
  OBSERVER
  DELIBERATOR
}

enum InterviewDecision {
  YES
  MAYBE_YES
  UNSURE
  MAYBE_NO
  NO
}

enum CaseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CasePageType {
  NORMAL
  EXHIBIT
  INTERVIEWER_ONLY
}

enum MeetingCommunicationType {
  CONFIRMATION
  HOST_NOTIFICATION
  CANCELLATION
  RESCHEDULED
  REMINDER
}

/// Where a candidate stands in a slot.
///
/// CONFIRMED and WAITLISTED are the only two that hold a place; the rest are
/// history. A candidate is never WAITLISTED without a CONFIRMED row elsewhere
/// (see InterviewSlotSignup.heldSeatId) - except that when nothing is free
/// anywhere, we refuse to invent a seat and file NEEDS_PLACEMENT instead, which
/// alerts admins rather than leaving someone in silent limbo.
enum InterviewSlotSignupStatus {
  CONFIRMED
  WAITLISTED
  NEEDS_PLACEMENT
  CANCELLED
  /// A fallback seat given up automatically when its waitlist entry was promoted.
  /// Distinct from CANCELLED so "the system moved me" and "I dropped out" do not
  /// read the same in the audit trail.
  RELEASED
}

enum InterviewSlotNotificationType {
  CONFIRMATION
  WAITLIST_ADDED
  PROMOTED
  FALLBACK_RELEASED
  CANCELLATION
  MOVED_BY_ADMIN
  /// To interviewers, before a schedule exists: tell us when you are free.
  AVAILABILITY_REQUEST
  /// To an interviewer, once recruitment has placed them in a session.
  INTERVIEWER_ASSIGNED
  INTERVIEWER_MOVED
  INTERVIEWER_REMOVED
  /// To recruitment, not the candidate: every slot was full, somebody needs a
  /// seat found for them by hand.
  ADMIN_OVERFLOW_ALERT
  REMINDER
}

/// A message someone started writing and has not sent.
///
/// Deliberately separate from MessageTemplate. A template is reusable
/// boilerplate - a name, a subject and a body meant to be applied to many
/// sends. A draft is one specific unsent message, so it also carries the
/// audience and the filters that decide who it goes to; reopening it puts the
/// composer back exactly as it was left. Folding the two together would make
/// the template list a mix of "ready to reuse" and "half-written", with nothing
/// to tell them apart.
///
/// Shared across admins rather than private, so comms can be written by one
/// person and finished by another. updatedById records who touched it last,
/// which is the thing you want to know before sending someone else's draft.
model MessageDraft {
  id          String           @id @default(uuid())
  name        String
  channel     String
  audience    String
  /// The composer's filter object, stored whole. Its shape is owned by
  /// resolveRecipients and changes as audiences gain filters, so pinning it to
  /// columns here would mean a migration every time one is added.
  filters     Json?
  subject     String           @default("")
  body        String
  cycleId     String?
  createdById String
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  cycle       RecruitingCycle? @relation("CycleDrafts", fields: [cycleId], references: [id], onDelete: SetNull)
  creator     User             @relation("MessageDraftCreator", fields: [createdById], references: [id])
  editor      User?            @relation("MessageDraftEditor", fields: [updatedById], references: [id])

  @@index([cycleId])
  @@index([updatedAt])
  @@map("message_drafts")
}

model MessageTemplate {
  id        String            @id @default(uuid())
  name      String
  subject   String
  body      String
  channel   String
  cycleId   String
  createdBy String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  cycle     RecruitingCycle   @relation("CycleTemplates", fields: [cycleId], references: [id], onDelete: Cascade)
  creator   User              @relation("MessageTemplateCreator", fields: [createdBy], references: [id])
  logs      MessageLog[]
  schedules MessageSchedule[]

  @@index([cycleId])
  @@map("message_templates")
}

model MessageLog {
  id             String            @id @default(uuid())
  templateId     String?
  channel        String
  recipientCount Int
  subject        String?
  body           String?
  sentAt         DateTime          @default(now())
  sentBy         String
  cycleId        String?
  template       MessageTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  cycle          RecruitingCycle?  @relation("CycleLogs", fields: [cycleId], references: [id], onDelete: SetNull)
  sender         User              @relation("MessageLogSender", fields: [sentBy], references: [id])
  schedules      MessageSchedule[]
  communications CommunicationLog[]

  @@index([cycleId])
  @@index([sentAt])
  @@map("message_logs")
}

/// Every outbound message this system produced, one row per recipient.
///
/// Written at the three points anything leaves: `sendEmail` in
/// emailNotifications.js (all mail, automated or hand-written), `sendSlackMessage`,
/// and the iMessage hand-off in masterCommunications.js. MessageLog above stays
/// what it was - the campaign-level record of a bulk send - and a bulk send's
/// per-person rows point back at it through `messageLogId`.
///
/// Recording is best-effort by design: a failure to write this row must never
/// fail the send it describes.
model CommunicationLog {
  id                String   @id @default(uuid())
  /// email | slack | imessage
  channel           String   @default("email")
  /// What kind of message this was - see COMMUNICATION_CATEGORIES in
  /// services/communicationLog.js. Free text so a new email needs no migration.
  category          String   @default("OTHER")
  /// AUTOMATED (the system decided to send) | MANUAL (a person pressed send)
  trigger           String   @default("AUTOMATED")
  /// SENT | FAILED | OPENED (iMessage: handed to Messages, delivery unobservable)
  status            String   @default("SENT")
  /// Address, channel name or phone number, exactly as addressed.
  recipient         String
  recipientName     String?
  subject           String?
  /// First ~2000 characters of the plain-text body, enough to identify a message
  /// without storing every decision letter twice.
  bodyPreview       String?
  /// Provider error text when status is FAILED.
  error             String?
  providerMessageId String?
  /// Identifies one message to one recipient across retries. The senders retry
  /// up to three times, and without this a transient failure left a FAILED row
  /// next to the SENT one for the same message. Null for a send that is never
  /// retried; Postgres allows many nulls under a unique index.
  attemptKey        String?  @unique
  hasAttachments    Boolean  @default(false)
  triggeredById     String?
  messageLogId      String?
  cycleId           String?
  sentAt            DateTime @default(now())

  triggeredBy User?            @relation("CommunicationLogTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)
  messageLog  MessageLog?      @relation(fields: [messageLogId], references: [id], onDelete: SetNull)
  cycle       RecruitingCycle? @relation("CycleCommunicationLogs", fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([sentAt])
  @@index([recipient])
  @@index([category])
  @@index([channel])
  @@index([status])
  @@index([cycleId])
  @@index([messageLogId])
  @@map("communication_logs")
}

model MessageSchedule {
  id           String           @id @default(uuid())
  channel      String
  audience     String
  filters      Json             @default("{}")
  subject      String?
  body         String
  cycleId      String?
  templateId   String?
  sentBy       String
  scheduledAt  DateTime
  status       String           @default("PENDING")
  messageLogId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  template     MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  cycle        RecruitingCycle? @relation("ScheduleCycle", fields: [cycleId], references: [id], onDelete: SetNull)
  sender       User             @relation("ScheduleSender", fields: [sentBy], references: [id])
  messageLog   MessageLog?      @relation(fields: [messageLogId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([status])
  @@index([cycleId])
  @@map("message_schedules")
}

// ---------------------------------------------------------------------------
// Talent Partner Network - client resume portal
// ---------------------------------------------------------------------------
// Applicant consent lives on Application.talentPoolOptIn (added by the TPN
// commit); member consent lives on MemberResume.shareConsent. Nothing in this
// section is assignable without one of those recording an explicit yes.

enum ResumeVisibility {
  BLIND
  BASIC
  FULL
}

/// One outside organization that bought resume-database access. 1:1 with a User
/// of role CLIENT, which owns email/password/isActive - so the existing
/// PATCH /api/users/:id/deactivate and invalidateUserCache apply unchanged and
/// this table deliberately has no isActive of its own.
model TalentPartnerClient {
  id           String                   @id @default(uuid())
  userId       String                   @unique
  organization String
  visibility   ResumeVisibility         @default(BLIND)
  notes        String?
  createdById  String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  user         User                     @relation("TalentPartnerClientUser", fields: [userId], references: [id], onDelete: Cascade)
  creator      User                     @relation("TalentPartnerClientCreator", fields: [createdById], references: [id])
  assignments  ClientResumeAssignment[]
  batches      ClientAssignmentBatch[]
  accessLogs   ClientResumeAccessLog[]

  @@index([organization])
  @@map("talent_partner_clients")
}

/// Member-uploaded resume. Deliberately NOT unique on memberId: re-uploading
/// creates a new row and demotes the old one (isCurrent = false), so an
/// already-committed assignment keeps pointing at the exact file that was
/// assigned. With a unique memberId the snapshot guarantee would be false for
/// members - a re-upload would silently swap the PDF under a client.
///
/// NOTE: a partial unique index enforces one isCurrent row per member. It lives
/// in migration.sql only - Prisma cannot express filtered unique indexes, and
/// `prisma migrate dev` will want to drop it.
model MemberResume {
  id               String                   @id @default(uuid())
  memberId         String
  isCurrent        Boolean                  @default(true)
  storagePath      String
  originalName     String
  fileSize         Int
  major1           String
  major2           String?
  // Normalized 4-digit year collected at upload. NOT derived from
  // User.graduationClass, which is free text like "Spring 2027" and therefore
  // does not filter alike with Application.graduationYear ("2029").
  graduationYear   String
  gender           String?
  shareConsent     Boolean                  @default(false)
  consentAt        DateTime?
  consentRevokedAt DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  member           User                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignments      ClientResumeAssignment[]

  @@index([memberId, isCurrent])
  @@index([shareConsent, isCurrent])
  @@map("member_resumes")
}

/// Resume uploaded by a UCLA student who is neither an applicant nor a member -
/// someone who found the talent portal and signed up for it directly. The third
/// and last source of assignable resumes.
///
/// Deliberately a separate table from MemberResume rather than a nullable-member
/// variant of it. The two differ in the gate that makes them assignable:
/// a member is vouched for by having been recruited, whereas an external account
/// is vouched for by nothing but a verified @ucla.edu address. Keeping them
/// apart means a query can never accidentally treat one as the other, and the
/// `ownerVerified` requirement below has exactly one place to live.
///
/// Same supersede-on-re-upload design as MemberResume, for the same reason: an
/// assignment already committed to a client must keep pointing at the exact file
/// that was assigned. The partial unique index enforcing one isCurrent row per
/// user lives in migration.sql - Prisma cannot express filtered unique indexes.
model ExternalResume {
  id               String                   @id @default(uuid())
  userId           String
  isCurrent        Boolean                  @default(true)
  storagePath      String
  originalName     String
  fileSize         Int
  major1           String
  major2           String?
  // Normalized 4-digit year, collected at upload for the same reason
  // MemberResume collects it: User.graduationClass is free text ("Spring 2027")
  // and would not filter alike with Application.graduationYear ("2029").
  graduationYear   String
  gender           String?
  shareConsent     Boolean                  @default(false)
  consentAt        DateTime?
  consentRevokedAt DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments      ClientResumeAssignment[]

  @@index([userId, isCurrent])
  @@index([shareConsent, isCurrent])
  @@map("external_resumes")
}

/// One admin "assign" action. filterJson records the filter that produced the
/// batch purely as documentation - the assignments are a snapshot and are never
/// re-derived from it.
model ClientAssignmentBatch {
  id           String                   @id @default(uuid())
  clientId     String
  createdById  String
  filterJson   Json?
  matchedCount Int                      @default(0)
  note         String?
  createdAt    DateTime                 @default(now())
  client       TalentPartnerClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator      User                     @relation("ClientBatchCreator", fields: [createdById], references: [id])
  assignments  ClientResumeAssignment[]

  @@index([clientId, createdAt])
  @@map("client_assignment_batches")
}

/// SNAPSHOT. Exactly one of applicationId / memberResumeId / externalResumeId is
/// non-null, enforced by a CHECK constraint in migration.sql (Prisma cannot
/// express CHECK).
/// Revocation is soft, matching the deactivatedAt / CaseAssignment.overriddenAt
/// convention, so history and the access log keep valid foreign keys.
///
/// NOTE: duplicate assignment is prevented by two partial unique indexes in
/// migration.sql. A plain @@unique would not work - Postgres treats NULLs as
/// distinct, so every row with a null target would count as unique.
model ClientResumeAssignment {
  id               String                  @id @default(uuid())
  clientId         String
  batchId          String
  applicationId    String?
  memberResumeId   String?
  externalResumeId String?
  assignedById     String
  assignedAt       DateTime                @default(now())
  revokedAt        DateTime?
  revokedById      String?
  client           TalentPartnerClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  batch            ClientAssignmentBatch   @relation(fields: [batchId], references: [id])
  application      Application?            @relation(fields: [applicationId], references: [id])
  memberResume     MemberResume?           @relation(fields: [memberResumeId], references: [id])
  externalResume   ExternalResume?         @relation(fields: [externalResumeId], references: [id])
  assigner         User                    @relation("ClientAssignmentAssigner", fields: [assignedById], references: [id])
  revoker          User?                   @relation("ClientAssignmentRevoker", fields: [revokedById], references: [id])
  accessLogs       ClientResumeAccessLog[]

  // Covers the portal's only list query (filter + sort) in one index.
  @@index([clientId, revokedAt, assignedAt])
  @@index([batchId])
  // Postgres does not auto-index foreign key columns, and the preview's
  // "already assigned?" check filters on these.
  @@index([applicationId])
  @@index([memberResumeId])
  @@index([externalResumeId])
  @@map("client_resume_assignments")
}

/// The first access-log table in this schema. House style is attribution columns
/// on the row (User.deactivatedBy, CaseAssignment.overriddenBy), but an
/// attribution column cannot express a repeated event, and a resume view is
/// exactly that. Written on every PDF fetch, including denied ones.
model ClientResumeAccessLog {
  id           String                  @id @default(uuid())
  clientId     String
  userId       String
  assignmentId String?
  // What the client did. Defaults to VIEW so every row written before the
  // action column existed keeps its original meaning - they were all PDF
  // fetches. An EXPORT writes one row per resume in the CSV, so the count of
  // rows a partner has pulled out stays readable off this table alone.
  action       ClientAccessAction      @default(VIEW)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime                @default(now())
  client       TalentPartnerClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User                    @relation("ClientAccessLogUser", fields: [userId], references: [id])
  assignment   ClientResumeAssignment? @relation(fields: [assignmentId], references: [id])

  @@index([clientId, createdAt])
  @@index([clientId, action, createdAt])
  @@index([assignmentId])
  @@map("client_resume_access_logs")
}

/// VIEW_DENIED is written when a client asks for an assignment id that is not
/// theirs, was revoked, or has no file their visibility permits - the half of
/// the record worth keeping, and previously indistinguishable from a VIEW with
/// a null assignmentId.
enum ClientAccessAction {
  VIEW
  VIEW_DENIED
  EXPORT
}

// ---------------------------------------------------------------------------
// Live vote deliberations
//
// An admin opens a session on one Staging round, admins and members join from
// anywhere in the app, and the room votes yes/no on one candidate at a time.
// Votes are anonymous to everyone: the voter is stored only as an HMAC of
// (ballot, user) under a server secret, which is enough to enforce one vote per
// person and to answer "what did I vote" without letting a database reader
// match a vote to a person.
// ---------------------------------------------------------------------------

enum LiveVoteSessionStatus {
  LOBBY
  ACTIVE
  ENDED
}

enum LiveVoteBallotStatus {
  OPEN
  CLOSED
}

enum LiveVoteValue {
  YES
  NO
}

/// The default rubric for one Staging round, shown beside a live vote. Sessions
/// copy it when they launch, so editing it never rewrites a past session.
model DeliberationRubric {
  id          String   @id @default(uuid())
  /// 'resume' | 'coffee' | 'firstRound' | 'final' - see utils/roundProgression.js
  phase       String   @unique
  /// [{ id, title, description }]
  criteria    Json     @default("[]")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("deliberation_rubrics")
}

/// Admin-editable copy explaining what each InterviewDecision means, shown to a
/// reviewer while they pick one. `phase` is a round from roundProgression.js, or
/// 'general' for the base every round inherits from.
model DecisionGuide {
  id          String   @id @default(uuid())
  /// 'general' | 'resume' | 'coffee' | 'firstRound' | 'final'
  phase       String   @unique
  /// { intro, criteria: { YES, MAYBE_YES, MAYBE_NO, NO } } - empty strings inherit.
  guide       Json     @default("{}")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("decision_guides")
}

/// Admin-editable wording for one automatic email, keyed by the template key in
/// services/emailTemplateCopy.js. A row holds only the fields an admin changed;
/// every field it leaves blank falls back to the wording shipped in the code,
/// which is also what deleting the row restores.
model EmailTemplateCopy {
  id          String   @id @default(uuid())
  /// A key from EMAIL_COPY_SCHEMA, e.g. 'rsvp-confirmation'.
  templateKey String   @unique
  /// { fieldName: string }. Fields the template does not declare are dropped on save.
  copy        Json     @default("{}")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_template_copy")
}

/// A person from the retired recruiting-interest mailing list whom the ATS had
/// no other record of when they were imported. They exist so Master
/// Communications can email them, through the "Mailing list" audience.
model MailingListContact {
  id           String   @id @default(uuid())
  /// Stored lowercased, like every other address in this schema.
  email        String   @unique
  firstName    String?
  lastName     String?
  /// Name of the CSV this contact came from.
  sourceFile   String?
  importedById String?
  createdAt    DateTime @default(now())

  @@map("mailing_list_contacts")
}

/// At most one LOBBY/ACTIVE session exists across the whole app, enforced by the
/// partial unique index `live_vote_sessions_single_open`, which Prisma cannot
/// express and which lives in the migration SQL.
model LiveVoteSession {
  id           String                     @id @default(uuid())
  cycleId      String
  phase        String
  status       LiveVoteSessionStatus      @default(LOBBY)
  currentIndex Int?
  /// Bumped by every change, votes included. Clients poll and compare it.
  version      Int                        @default(0)
  /// Rubric criteria as they were when the session launched.
  rubric       Json                       @default("[]")
  createdById  String
  endedById    String?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  cycle        RecruitingCycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  createdBy    User                       @relation("LiveVoteSessionCreator", fields: [createdById], references: [id])
  candidates   LiveVoteSessionCandidate[]
  ballots      LiveVoteBallot[]
  participants LiveVoteParticipant[]

  @@index([cycleId, phase])
  @@index([status])
  @@map("live_vote_sessions")
}

model LiveVoteSessionCandidate {
  id            String           @id @default(uuid())
  sessionId     String
  applicationId String
  position      Int
  session       LiveVoteSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ballots       LiveVoteBallot[]

  @@unique([sessionId, applicationId])
  @@unique([sessionId, position])
  @@index([applicationId])
  @@map("live_vote_session_candidates")
}

/// One round of voting on one candidate. Re-opening a vote adds roundNumber + 1
/// and leaves earlier rounds as history. At most one OPEN ballot per session
/// (partial unique index `live_vote_ballots_single_open`).
model LiveVoteBallot {
  id                 String                   @id @default(uuid())
  sessionId          String
  sessionCandidateId String
  roundNumber        Int
  status             LiveVoteBallotStatus     @default(OPEN)
  openedAt           DateTime                 @default(now())
  openedById         String
  closedAt           DateTime?
  closedById         String?
  /// Frozen at close. Never read while the ballot is open.
  yesCount           Int?
  noCount            Int?
  eligibleCount      Int?
  /// The Staging decision an admin applied after this round, if any.
  decisionApplied    String?
  decidedById        String?
  decidedAt          DateTime?
  session            LiveVoteSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionCandidate   LiveVoteSessionCandidate @relation(fields: [sessionCandidateId], references: [id], onDelete: Cascade)
  votes              LiveVoteVote[]

  @@unique([sessionCandidateId, roundNumber])
  @@index([sessionId, status])
  @@map("live_vote_ballots")
}

/// No user id and no timestamp, on purpose - see the section comment above.
model LiveVoteVote {
  id       String         @id @default(uuid())
  ballotId String
  voterKey String
  value    LiveVoteValue
  ballot   LiveVoteBallot @relation(fields: [ballotId], references: [id], onDelete: Cascade)

  @@unique([ballotId, voterKey])
  @@map("live_vote_votes")
}

model LiveVoteParticipant {
  id         String          @id @default(uuid())
  sessionId  String
  userId     String
  joinedAt   DateTime        @default(now())
  lastSeenAt DateTime        @default(now())
  leftAt     DateTime?
  session    LiveVoteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User            @relation("LiveVoteParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("live_vote_participants")
}
