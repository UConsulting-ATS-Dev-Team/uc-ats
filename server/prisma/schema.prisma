  creator               User                            @relation("InterviewCreator", fields: [createdBy], references: [id])
  cycle                 RecruitingCycle                 @relation(fields: [cycleId], references: [id])
  caseAssignments       CaseAssignment[]
  slots                 InterviewSlot[]
  availability          InterviewerAvailability[]
