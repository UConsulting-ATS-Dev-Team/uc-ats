DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
GOOGLE_CLOUD_KEY_PATH=./google-cloud-key.json
FORM_CONFIG_PATH="./form-config.json"

# REQUIRED. Server fails to boot if unset. Use a long random string.
JWT_SECRET='change-me-in-prod'
# Optional. How long issued tokens remain valid.
JWT_EXPIRES_IN=8h

# REQUIRED. Shared secret presented by anyone using POST /api/auth/register-member.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MEMBER_REGISTRATION_TOKEN='change-me-in-prod'

# Comma-separated allowlist of origins permitted by CORS.
# Defaults to the client URL in prod, http://localhost:5173 in dev.
CORS_ORIGIN=http://localhost:5173

# Base URL for file serving (use your production domain in production)
BASE_URL=http://localhost:3001

# Client URL for frontend links (password reset, etc.)
# In production, set to: https://uconsultingats.com
CLIENT_URL=http://localhost:5173

# Email configuration for password reset and event notifications
EMAIL_USER='your-email@gmail.com'
EMAIL_PASS='your-app-specific-password'

# Slack configuration for admin messaging
SLACK_WEBHOOK_URL='https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK'

# Supabase configuration for realtime messaging (interview chat).
# Find these in your Supabase dashboard: Settings → API.
# SUPABASE_SERVICE_ROLE_KEY is server-only — never expose to the client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Calendar auto-invite for events (admin/member invitees on event create/update).
# Setup (one-time):
#   1. Create a Google Calendar (e.g. "UConsulting Events") in the Google account that
#      should own recruiting event invites.
#   2. Share it with the service account below as Editor: Settings > Share with specific
#      people > add the service account email > permission "Make changes to events".
#      Service account email is the "client_email" field in your GOOGLE_CLOUD_KEY_PATH file.
#   3. Open the calendar's Settings > "Integrate calendar" and copy its Calendar ID here.
# If unset, event create/update still works normally — calendar invites are just skipped
# (a warning is logged).
GOOGLE_CALENDAR_ID=

# While set, ALL calendar invites (regardless of real recipients) are redirected to this one
# address instead of real admins/members. Use this to test end-to-end before going live, then
# unset it (or leave blank) to actually notify real admins/members.
CALENDAR_INVITE_TEST_EMAIL=