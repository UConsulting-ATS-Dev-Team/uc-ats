# Supabase database connection
#
# The direct host db.<project-ref>.supabase.co is IPv6-only. If you see
# "Can't reach database server ... Network is unreachable" / "EAI_AGAIN", use the
# IPv4 session pooler below. Port 5432 is session mode; port 6543 is transaction
# mode and breaks Prisma migrations — never use 6543.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-us-east-2.pooler.supabase.com:5432/postgres
#DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres

# Prisma uses DIRECT_URL for migrations and introspection. In this setup it
# should also be the session pooler unless your environment has IPv6.
DIRECT_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-us-east-2.pooler.supabase.com:5432/postgres
#DIRECT_URL=postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres

GOOGLE_CLOUD_KEY_PATH=./google-cloud-key.json
FORM_CONFIG_PATH="./form-config.json"

# REQUIRED. Server fails to boot if unset. Use a long random string.
JWT_SECRET='change-me-in-prod'
# Optional. Keys anonymous live vote ballots to voters; defaults to JWT_SECRET.
# LIVE_VOTE_SECRET=''
# Optional. Signs Master Communications unsubscribe links; defaults to JWT_SECRET.
# Rotating it breaks every link already sent.
# UNSUBSCRIBE_SECRET=''
# Optional. How long issued tokens remain valid.
JWT_EXPIRES_IN=8h

# REQUIRED. Shared secret presented by anyone using POST /api/auth/register-member.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MEMBER_REGISTRATION_TOKEN='change-me-in-prod'

# Comma-separated allowlist of origins permitted by CORS.
# Defaults to the client URL in prod, http://localhost:5173 in dev.
CORS_ORIGIN=http://localhost:5173

# Base URL for file serving (use your production domain in production)
BASE_URL=http://localhost:3001

# Client URL for frontend links (password reset, etc.)
# In production, set to: https://uconsultingats.com
CLIENT_URL=http://localhost:5173

# Email configuration (Amazon SES v2 API over HTTPS).
# The from-address must be under a domain (or identity) verified in SES.
# Credentials are those of an IAM user with the ses:SendEmail permission.
AWS_REGION=us-west-1
AWS_ACCESS_KEY_ID='your-iam-access-key-id'
AWS_SECRET_ACCESS_KEY='your-iam-secret-access-key'
EMAIL_FROM='no-reply@uconsultingats.com'
# Replies from recipients are routed here (a monitored inbox).
EMAIL_REPLY_TO='uconsultingla@gmail.com'
# Delivery tracking (optional). The configuration set's event destination
# publishes to the SNS topic, which is subscribed to <BASE_URL>/api/webhooks/ses.
# Unset SES_SNS_TOPIC_ARN means the webhook refuses everything.
SES_CONFIGURATION_SET='ats-delivery-events'
SES_SNS_TOPIC_ARN='arn:aws:sns:us-west-1:123456789012:ats-ses-events'

# Slack configuration for admin messaging
SLACK_WEBHOOK_URL='https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK'

# Supabase configuration for realtime messaging (interview chat).
# Find these in your Supabase dashboard: Settings → API.
# SUPABASE_SERVICE_ROLE_KEY is server-only — never expose to the client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Interview scheduling emails. Off unless set to "on" - see config.js for why.
SCHEDULING_EMAILS=on

# Sign in with Google. The OAuth client id from Google Cloud Console
# (APIs & Services → Credentials → Web application), used here as the audience
# an ID token is verified against.
#
# Nothing to do with GOOGLE_CLOUD_KEY_PATH above: that is a service account this
# server acts as when reading Forms and Drive, this is the browser-facing client
# a person signs in through. Different credentials, same Google project.
#
# Must match VITE_GOOGLE_CLIENT_ID in client/.env exactly. Unset means the
# Google endpoint answers 503 and password sign-in carries on as normal.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The hourly Luma sync routine (docs/luma-sync-routine.md). Random, at least
# 32 characters: a shorter value is treated as a placeholder somebody meant to
# replace, and /api/integrations/luma answers 503 as if it were unset. The same
# value goes in the routine environment on the owner's Claude account.
LUMA_SYNC_TOKEN=generate-a-long-random-value-here
